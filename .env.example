# All of these have working defaults in lib/config.ts. Set them only to override.

# Turns the Google SSO gate back on. Anything other than "true" leaves the app public.
NEXT_PUBLIC_AUTH_ENABLED=false

NEXT_PUBLIC_SUPABASE_URL=https://pmmyqxdmjyxzsknvfpbr.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_qUiVleGmbSe-RIyDPtsF6Q_E2cK2veB

# Check-in ingest. BOTH must be set or POST /api/checkin/ingest reports itself
# disabled and writes nothing. See "Check-in ingest" in the README.
# SUPABASE_SERVICE_ROLE_KEY is server-only — never give it a NEXT_PUBLIC_ prefix.
CHECKIN_INGEST_TOKEN=
SUPABASE_SERVICE_ROLE_KEY=

# Weekly report narrative drafting. Absent, the "Draft from this week" button
# hides itself. Server-only — never give this a NEXT_PUBLIC_ prefix.
ANTHROPIC_API_KEY=
# Optional override; defaults to claude-sonnet-5.
NARRATIVE_MODEL=
